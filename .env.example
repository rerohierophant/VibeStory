# Copy to .env and fill in private values. Run `set -a; source .env; set +a` before Gradle.
DATABASE_URL=jdbc:postgresql://localhost:5432/vibestory
DATABASE_USER=vibestory
DATABASE_PASSWORD=
DATABASE_NAME=vibestory
DATABASE_PORT=5432
SEED_EMAIL=
SEED_PASSWORD=
PORT=8080
MOCK_DELAY=3s
MOCK_FAILURE_RATE=0
MOCK_FAILURE_MODE=known
# Refuse startup unless text, image and video providers are all Mock.
MOCK_ONLY=false
TEXT_PROVIDER=mock
TEXT_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-flash
TEXT_API_KEY=
TEXT_TIMEOUT=120s
TEXT_MAX_TOKENS=8192
TEXT_DISABLE_THINKING=true
IMAGE_PROVIDER=mock
# Image generation supports MiniMax (/image_generation) and local Mock only.
IMAGE_BASE_URL=https://api.minimax.cn/v1
IMAGE_MODEL=image-01
IMAGE_API_KEY=
IMAGE_TIMEOUT=120s
VIDEO_PROVIDER=mock
VIDEO_BASE_URL=https://api.minimax.cn/v1
VIDEO_MODEL=MiniMax-Hailuo-2.3-Fast
# VIDEO_API_KEY defaults to IMAGE_API_KEY; no duplicate key is needed for MiniMax.
VIDEO_TIMEOUT=60s
VIDEO_POLL_INTERVAL=5s
VIDEO_GENERATION_TIMEOUT=20m
# Absolute path recommended; Gradle bootRun uses apps/api as the working directory.
# STORAGE_ROOT=/absolute/path/to/VibeStory/data/storage
# Optional: use an isolated schema in a real PostgreSQL 16 database when Docker is unavailable.
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/vibestory_test
# TEST_DATABASE_USER=vibestory
# TEST_DATABASE_PASSWORD=

# Phase 7. Existing all-Mock verification keeps database/all mode.
DISPATCH_MODE=database
APP_ROLE=all
MQ_NAMESPACE=vibestory
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MQ_PREFETCH=2
TEXT_SLOTS=1
IMAGE_SLOTS=2
VIDEO_SLOTS=2
RELAY_ENABLED=true
